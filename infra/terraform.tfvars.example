# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
project_name = "salary-calculator"
region       = "us-east-1"
aws_profile  = "yevhenii"
db_name      = "salary"

# Major-only pin: AWS resolves the current default minor. See variables.tf.
db_engine_version = "15"

# ---------------------------------------------------------------------------
# REQUIRED: who hears about a cost overrun.
#
# There is no default and the variable is validated as non-empty, so a plan
# fails until this is set. A budget nobody is subscribed to looks like
# protection without being any.
# ---------------------------------------------------------------------------
budget_alert_emails = ["you@example.com"]

# ---------------------------------------------------------------------------
# COST — read infra/cost.md before changing anything below.
#
# db_min_acu = 0 is what keeps this stack near $0 when idle: Aurora
# Serverless v2 pauses to zero ACUs after db_seconds_until_auto_pause.
# Setting it to 0.5 bills ~$44/MONTH even with nobody using the app — more
# than four times the entire $10 target, on its own.
#
# The trade-off is a ~15 second resume on the first request after idle.
# ---------------------------------------------------------------------------
db_min_acu                  = 0
db_max_acu                  = 1
db_seconds_until_auto_pause = 300

monthly_budget_usd     = 10
cloudfront_price_class = "PriceClass_100"

# ---------------------------------------------------------------------------
# Bedrock token: deliberately NOT set here.
#
# It comes from your local environment instead, via ./infra/deploy.sh:
#
#     ./infra/deploy.sh plan
#     ./infra/deploy.sh apply
#
# That maps the AWS_BEARER_TOKEN_BEDROCK you already export for local
# development to TF_VAR_bedrock_bearer_token. Keeping it out of this file means
# one copy of a long-lived credential instead of two, and nothing sensitive
# sitting in plaintext inside the repo directory.
#
# Generate one with: aws bedrock create-api-key --profile yevhenii
# Scope the permissions of the identity you generate it under — a bearer token
# is authorized against its creating principal, NOT the Lambda's execution
# role, so the anthropic.* scoping in iam.tf does not bound it.
# ---------------------------------------------------------------------------
