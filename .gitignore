# JetBrains IDE
.idea/
*.iml

# Node
node_modules/
dist/
build/
# infra/build/ holds the deploy SCRIPT and must stay tracked...
!infra/build/
!infra/build/**
# ...but infra/.build/ is where Terraform writes the Lambda zips. Those are rebuilt on every
# deploy, so tracking them means a churning binary diff in every commit — and the negations
# above were broad enough to un-ignore them.
infra/.build/
*.log

# Env / secrets
.env
.env.*
!.env.example

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# Client spreadsheets — real staff names and business data. Never commit these;
# parser tests use the synthetic fixture in packages/core/test/fixtures instead.
docs/*.xlsx
docs/*.xls
# Parallel-development git worktrees live here; each is its own checkout.
.worktrees/
