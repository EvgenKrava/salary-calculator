{
  "name": "@salary/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/api.js --external:@aws-sdk/* && esbuild src/migrationHandler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/migrate.js --external:@aws-sdk/*"
  },
  "dependencies": {
    "@salary/core": "workspace:*",
    "@aws-sdk/client-rds-data": "^3.665.0",
    "aws-jwt-verify": "^4.0.1",
    "drizzle-orm": "^0.36.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.7.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.2"
  }
}